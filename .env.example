# ─── FRONTEND PRODUCTION ENVIRONMENT VARIABLES ─────────────────────────────
# Supabase Configuration
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# Doctor / Staff Admin Authentication
VITE_ADMIN_EMAIL="admin@lavanyadental.in"
# SHA-256 hash of staff admin password (e.g. echo -n 'your_password' | sha256sum)
VITE_ADMIN_PASSWORD_HASH="e0bc60c82713f64ef8a57c0c40d02ce24fd0141d5cc3086259c19b1e62a62bea"

# ─── WHATSAPP BOT BACKEND ENVIRONMENT VARIABLES ───────────────────────────
# Google Gemini AI Studio API Key (Never commit this key to Git)
GEMINI_API_KEY="your-gemini-api-key"

# Secret token to protect WhatsApp Bot administrative reset/settings endpoints
BOT_ADMIN_SECRET="your-strong-random-secret-token"

# Port for bot web server (Defaults to 3005)
PORT=3005
